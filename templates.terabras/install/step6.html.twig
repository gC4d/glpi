{#
 # Terabras override of `install/step6.html.twig`.
 #
 # Three product changes over upstream:
 #  1. Telemetry is opt-IN: the checkbox ships unchecked, so continuing the wizard
 #     without touching it leaves the `telemetry` cron task disabled (its
 #     `empty_data.php` default). Upstream renders it `checked` via
 #     `Telemetry::showTelemetry()`, which would silently opt every customer in.
 #  2. The "Reference your GLPI" block (`reference_info`) is dropped: it is a
 #     promotional link to the GLPI registration form, not part of installing the
 #     product.
 #  3. The form posts `Etape_6` instead of `Etape_5`, skipping the GLPI Network
 #     commercial-offer step (`step7`), which displays nothing the installation
 #     needs. No licence or copyright notice is carried by that step.
 #
 # The telemetry explanation itself is kept verbatim (same msgids as upstream, so
 # translations still resolve): data really is sent to the GLPI project, and the
 # person deciding must be told so.
 #}

{% import 'components/form/fields_macros.html.twig' as fields %}

<h3>{{ __("Collect data") }}</h3>

<hr>

<form action="install.php" method="post" data-submit-once>
   <div class="form-check">
      <input type="checkbox" class="form-check-input" value="1" name="send_stats" id="send_stats">
      <label for="send_stats" class="form-check-label">
         {{ __('Send "usage statistics"') }}
      </label>
   </div>

   <p class="mt-3">
      {{ __("Since GLPI 9.2, we’ve introduced a new statistics feature called “Telemetry”, that anonymously with your permission, sends data to our telemetry website.") }}<br>
      {{ __("Once sent, usage statistics are aggregated and made available to a broad range of GLPI developers.") }}
   </p>

   <hr>

   <p>
      <button type="submit" name="submit" class="btn btn-primary">
         {{ __("Continue") }}
         <i class="ti ti-chevron-right ms-1"></i>
      </button>
   </p>

   <input type="hidden" name="install" value="Etape_6">
   {{ fields.csrfField() }}
</form>
